{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": false,
        "module": "ES2022",
        "moduleResolution": "bundler",
        "types": [
            "node",
            "vite/client"
        ],
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "paths": {
            "@layout/*": [
                "./src/layout/*"
            ],
            "@/*": [
                "./src/*"
            ],
            "pixi.js": [
                "../Volt-Renderer/node_modules/pixi.js",
                "../volt-renderer/node_modules/pixi.js",
                "../Octane-Renderer/node_modules/pixi.js",
                "../octane-renderer/node_modules/pixi.js",
                "../renderer/node_modules/pixi.js"
            ],
            "@volt/renderer": [
                "../Volt-Renderer/index.ts",
                "../volt-renderer/index.ts",
                "../Octane-Renderer/index.ts",
                "../octane-renderer/index.ts",
                "../renderer/index.ts"
            ],
            "@volt/*": [
                "../Volt-Renderer/packages/*/src/index.ts",
                "../volt-renderer/packages/*/src/index.ts",
                "../Octane-Renderer/packages/*/src/index.ts",
                "../octane-renderer/packages/*/src/index.ts",
                "../renderer/packages/*/src/index.ts"
            ]
        }
    },
    "include": [
        "src",
        "node_modules/@volt/renderer/src/**/*.ts"
    ]
}
